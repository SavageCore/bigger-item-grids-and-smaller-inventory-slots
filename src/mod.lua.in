-- Bigger Item Grids and Smaller Inventory Slots
-- The UI files below ship whole as MXML text in src/mxml (see SOURCES
-- there for provenance); AMUMSS compiles them to MBIN at build time.
-- UI scene files must ship as complete MBINs: the game does not apply
-- loose EXML overlays to them, so value-patch tables cannot be used
-- here the way they are for globals and tables.
local ModName     = "Bigger Item Grids and Smaller Inventory Slots"
local ModAuthor   = "SavageCore"
local GameVersion = "v7.04"

